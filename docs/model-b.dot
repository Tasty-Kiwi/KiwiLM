digraph KiwiLM_Model_B {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad=0.25,
        nodesep=0.22,
        ranksep=0.38,
        splines=ortho,
        fontname="Helvetica",
        fontsize=18,
        label="KiwiLM Model B — Gated CNN + RoPE Attention",
        labelloc=t
    ];

    node [
        shape=box,
        style="rounded,filled",
        color="#64748B",
        fillcolor="#F8FAFC",
        fontcolor="#0F172A",
        fontname="Helvetica",
        fontsize=11,
        margin="0.18,0.10",
        penwidth=1.2
    ];

    edge [
        color="#475569",
        fontname="Helvetica",
        fontsize=9,
        arrowsize=0.7,
        penwidth=1.3
    ];

    input [label="Input token IDs\n[B, T]  •  T ≤ 256", fillcolor="#DBEAFE", color="#3B82F6"];
    embedding [label="Token Embedding\n8,192 × 256", fillcolor="#DCFCE7", color="#22C55E"];

    subgraph cluster_pre {
        label="3 × Causal Gated CNN Blocks";
        color="#F59E0B";
        fontcolor="#92400E";
        style="rounded,dashed";
        pre1 [label="Block 1 • dilation 1\nPre-LN → causal Conv1d → GLU\nDropout → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
        pre2 [label="Block 2 • dilation 2\nPre-LN → causal Conv1d → GLU\nDropout → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
        pre3 [label="Block 3 • dilation 4\nPre-LN → causal Conv1d → GLU\nDropout → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
        pre1 -> pre2 -> pre3;
    }

    attention [
        label="Transformer Attention Block\nPre-LN → 8-head causal self-attention + RoPE → Residual\nPre-LN → MLP 256→1024→256 + GELU → Residual",
        fillcolor="#EDE9FE",
        color="#8B5CF6",
        penwidth=1.6
    ];

    subgraph cluster_post {
        label="3 × Causal Gated CNN Blocks";
        color="#F59E0B";
        fontcolor="#92400E";
        style="rounded,dashed";
        post1 [label="Block 4 • dilation 8\nPre-LN → causal Conv1d → GLU\nDropout → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
        post2 [label="Block 5 • dilation 16\nPre-LN → causal Conv1d → GLU\nDropout → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
        post3 [label="Block 6 • dilation 32\nPre-LN → causal Conv1d → GLU\nDropout → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
        post1 -> post2 -> post3;
    }

    final_norm [label="Final LayerNorm\n256 channels", fillcolor="#E2E8F0", color="#64748B"];
    lm_head [label="Tied Language-Model Head\nLinear 256 → 8,192 + bias", fillcolor="#F3E8FF", color="#A855F7"];
    logits [label="Next-token logits\n[B, T, 8,192]", fillcolor="#FFE4E6", color="#F43F5E"];
    summary [
        shape=note,
        style="filled",
        label="Default configuration\n5,261,056 parameters\nGlobal causal information path via attention\nEmbedding and LM-head weights are tied",
        fillcolor="#F1F5F9",
        color="#94A3B8",
        fontsize=10
    ];

    input -> embedding -> pre1;
    pre3 -> attention -> post1;
    post3 -> final_norm -> lm_head -> logits;
    embedding -> lm_head [
        xlabel="shared weights",
        style=dashed,
        color="#9333EA",
        fontcolor="#7E22CE",
        constraint=false
    ];
    { rank=same; final_norm; summary; }
    summary -> final_norm [style=invis];
}
