digraph KiwiLM_SAN {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad=0.25,
        nodesep=0.24,
        ranksep=0.42,
        splines=ortho,
        fontname="Helvetica",
        fontsize=18,
        label="KiwiLM-SAN — Simple Attention Network",
        labelloc=t
    ];

    node [
        shape=box,
        style="rounded,filled",
        color="#64748B",
        fillcolor="#F8FAFC",
        fontcolor="#0F172A",
        fontname="Helvetica",
        fontsize=10,
        margin="0.18,0.10",
        penwidth=1.2
    ];

    edge [
        color="#475569",
        arrowsize=0.7,
        penwidth=1.3
    ];

    input [label="Input token IDs\n[B, T]  •  T ≤ 256", fillcolor="#DBEAFE", color="#3B82F6"];
    embedding [label="Token Embedding × √256\n8,192 × 256", fillcolor="#DCFCE7", color="#22C55E"];
    pre_norm [label="Zero-centered RMSNorm\n256 channels", fillcolor="#E2E8F0", color="#64748B"];
    attention [label="Causal Grouped-Query Attention\n8 query heads • 4 KV heads • per-head QK norm • RoPE", fillcolor="#EDE9FE", color="#8B5CF6"];
    post_norm [label="Zero-centered Sandwich RMSNorm\n256 channels", fillcolor="#E2E8F0", color="#64748B"];
    gate [label="Sigmoid-gated Residual\nx + sigmoid(g) · attention(x)\ng initialized to 0", fillcolor="#FEF3C7", color="#F59E0B"];
    repeat [
        shape=note,
        style="filled",
        label="Repeat 16 attention-only blocks\nNo feed-forward network",
        fillcolor="#F1F5F9",
        color="#94A3B8",
        fontsize=10
    ];
    final_norm [label="Final Zero-centered RMSNorm\n256 channels", fillcolor="#E2E8F0", color="#64748B"];
    lm_head [label="Tied Language-Model Head\nLinear 256 → 8,192 + bias", fillcolor="#F3E8FF", color="#A855F7"];
    logits [label="Next-token logits\n[B, T, 8,192]", fillcolor="#FFE4E6", color="#F43F5E"];
    summary [
        shape=note,
        style="filled",
        label="Default configuration\n5,260,560 parameters\n16 attention-only layers\nCompact 4-head KV cache",
        fillcolor="#F1F5F9",
        color="#94A3B8",
        fontsize=10
    ];

    input -> embedding -> pre_norm -> attention -> post_norm -> gate;
    gate -> repeat -> final_norm -> lm_head -> logits;
    embedding -> lm_head [
        xlabel="shared weights",
        style=dashed,
        color="#9333EA",
        fontcolor="#7E22CE",
        constraint=false
    ];
    { rank=same; final_norm; summary; }
    summary -> final_norm [style=invis];
}
