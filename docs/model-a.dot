digraph KiwiLM_Model_A {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad=0.25,
        nodesep=0.22,
        ranksep=0.38,
        splines=ortho,
        compound=true,
        fontname="Helvetica",
        fontsize=18,
        label="KiwiLM Model A — Causal Gated CNN Language Model",
        labelloc=t,
        labeljust=c
    ];

    node [
        shape=box,
        style="rounded,filled",
        color="#64748B",
        fillcolor="#F8FAFC",
        fontcolor="#0F172A",
        fontname="Helvetica",
        fontsize=11,
        margin="0.18,0.10",
        penwidth=1.2
    ];

    edge [
        color="#475569",
        fontcolor="#334155",
        fontname="Helvetica",
        fontsize=9,
        arrowsize=0.7,
        penwidth=1.3
    ];

    input [
        label="Input token IDs\n[B, T]  •  T ≤ 256",
        fillcolor="#DBEAFE",
        color="#3B82F6"
    ];

    embedding [
        label="Token Embedding\n8,192 × 256\nweights ~ N(0, 0.02)",
        fillcolor="#DCFCE7",
        color="#22C55E"
    ];

    subgraph cluster_gated_stack {
        label="8 × Causal Gated CNN Blocks";
        color="#F59E0B";
        fontcolor="#92400E";
        fontsize=12;
        style="rounded,dashed";
        penwidth=1.4;
        margin=14;

        block_1 [label="Block 1  •  dilation 1\nLayerNorm → left-pad 2 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];
        block_2 [label="Block 2  •  dilation 2\nLayerNorm → left-pad 4 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];
        block_3 [label="Block 3  •  dilation 4\nLayerNorm → left-pad 8 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];
        block_4 [label="Block 4  •  dilation 8\nLayerNorm → left-pad 16 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];
        block_5 [label="Block 5  •  dilation 16\nLayerNorm → left-pad 32 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];
        block_6 [label="Block 6  •  dilation 32\nLayerNorm → left-pad 64 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];
        block_7 [label="Block 7  •  dilation 64\nLayerNorm → left-pad 128 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];
        block_8 [label="Block 8  •  dilation 128\nLayerNorm → left-pad 256 → Conv1d 256→512, k=3\nGLU 512→256 → Dropout → Residual Add", fillcolor="#FEF3C7", color="#F59E0B"];

        block_1 -> block_2 -> block_3 -> block_4 -> block_5 -> block_6 -> block_7 -> block_8;
    }

    final_norm [
        label="Final LayerNorm\n256 channels",
        fillcolor="#E2E8F0",
        color="#64748B"
    ];

    lm_head [
        label="Language-Model Head\nLinear 256 → 8,192 + bias",
        fillcolor="#F3E8FF",
        color="#A855F7"
    ];

    logits [
        label="Next-token logits\n[B, T, 8,192]",
        fillcolor="#FFE4E6",
        color="#F43F5E"
    ];

    summary [
        shape=note,
        style="filled",
        label="Default configuration\n5,259,776 parameters\n511-token receptive field\nStrictly causal • no future-token access\nEmbedding and LM-head weights are tied",
        fillcolor="#F1F5F9",
        color="#94A3B8",
        fontsize=10
    ];

    input -> embedding [xlabel="[B, T, 256]"];
    embedding -> block_1;
    block_8 -> final_norm;
    final_norm -> lm_head;
    lm_head -> logits;

    embedding -> lm_head [
        xlabel="shared weight matrix",
        style=dashed,
        color="#9333EA",
        fontcolor="#7E22CE",
        constraint=false,
        penwidth=1.5
    ];

    { rank=same; final_norm; summary; }
    summary -> final_norm [style=invis];
}
