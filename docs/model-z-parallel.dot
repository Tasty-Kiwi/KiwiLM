digraph KiwiLM_Model_Z_Parallel {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad=0.25,
        nodesep=0.25,
        ranksep=0.42,
        splines=ortho,
        fontname="Helvetica",
        fontsize=18,
        label="KiwiLM Model Z-P — Fixed Parallel Local/Global Fusion",
        labelloc=t
    ];

    node [
        shape=box,
        style="rounded,filled",
        color="#64748B",
        fillcolor="#F8FAFC",
        fontcolor="#0F172A",
        fontname="Helvetica",
        fontsize=10,
        margin="0.18,0.10",
        penwidth=1.2
    ];

    edge [
        color="#475569",
        arrowsize=0.7,
        penwidth=1.3
    ];

    input [label="Input token IDs\n[B, T]  •  T ≤ 256", fillcolor="#DBEAFE", color="#3B82F6"];
    embedding [label="Token Embedding\n8,192 × 256", fillcolor="#DCFCE7", color="#22C55E"];

    subgraph cluster_block1 {
        label="Parallel Block 1 • same residual input";
        color="#CBD5E1";
        style="rounded,dashed";
        b1_input [label="x₁", shape=circle, fillcolor="#F8FAFC"];
        b1_cnn [label="Local branch • dilation 1\nRMSNorm → causal Conv1d → GLU", fillcolor="#FEF3C7", color="#F59E0B"];
        b1_attn [label="Global branch\nRMSNorm → 8-head RoPE causal attention", fillcolor="#EDE9FE", color="#8B5CF6"];
        b1_merge [label="Fixed fusion\nx₁ + (CNN(x₁) + Attention(x₁)) / √2", fillcolor="#E0F2FE", color="#0EA5E9"];
        b1_ffn [label="Wide SwiGLU\nRMSNorm → 256→1,280 gate/up → 1,280→256 → residual", fillcolor="#ECFCCB", color="#84CC16"];
        b1_input -> b1_cnn;
        b1_input -> b1_attn;
        b1_input -> b1_merge [xlabel=" residual", fontsize=9];
        b1_cnn -> b1_merge;
        b1_attn -> b1_merge;
        b1_merge -> b1_ffn;
    }

    subgraph cluster_block2 {
        label="Parallel Block 2 • same residual input";
        color="#CBD5E1";
        style="rounded,dashed";
        b2_input [label="x₂", shape=circle, fillcolor="#F8FAFC"];
        b2_cnn [label="Local branch • dilation 2\nRMSNorm → causal Conv1d → GLU", fillcolor="#FEF3C7", color="#F59E0B"];
        b2_attn [label="Global branch\nRMSNorm → 8-head RoPE causal attention", fillcolor="#EDE9FE", color="#8B5CF6"];
        b2_merge [label="Fixed fusion\nx₂ + (CNN(x₂) + Attention(x₂)) / √2", fillcolor="#E0F2FE", color="#0EA5E9"];
        b2_ffn [label="Wide SwiGLU\nRMSNorm → 256→1,280 gate/up → 1,280→256 → residual", fillcolor="#ECFCCB", color="#84CC16"];
        b2_input -> b2_cnn;
        b2_input -> b2_attn;
        b2_input -> b2_merge [xlabel=" residual", fontsize=9];
        b2_cnn -> b2_merge;
        b2_attn -> b2_merge;
        b2_merge -> b2_ffn;
    }

    final_norm [label="Final RMSNorm\n256 channels", fillcolor="#E2E8F0", color="#64748B"];
    lm_head [label="Tied Language-Model Head\nLinear 256 → 8,192 + bias", fillcolor="#F3E8FF", color="#A855F7"];
    logits [label="Next-token logits\n[B, T, 8,192]", fillcolor="#FFE4E6", color="#F43F5E"];
    summary [
        shape=note,
        style="filled",
        label="Default configuration\n5,387,008 parameters\n2 CNN histories • 2 attention KV caches\nFixed branch scale 1 / √2",
        fillcolor="#F1F5F9",
        color="#94A3B8",
        fontsize=10
    ];

    input -> embedding -> b1_input;
    b1_ffn -> b2_input;
    b2_ffn -> final_norm -> lm_head -> logits;
    embedding -> lm_head [
        xlabel="shared weights",
        style=dashed,
        color="#9333EA",
        fontcolor="#7E22CE",
        constraint=false
    ];
    { rank=same; final_norm; summary; }
    summary -> final_norm [style=invis];
}
