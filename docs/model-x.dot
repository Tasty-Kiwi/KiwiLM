digraph KiwiLM_Model_X {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad=0.25,
        nodesep=0.22,
        ranksep=0.38,
        splines=ortho,
        fontname="Helvetica",
        fontsize=18,
        label="KiwiLM Model X — Alternating Local/Global SwiGLU Hybrid",
        labelloc=t
    ];

    node [
        shape=box,
        style="rounded,filled",
        color="#64748B",
        fillcolor="#F8FAFC",
        fontcolor="#0F172A",
        fontname="Helvetica",
        fontsize=10,
        margin="0.18,0.10",
        penwidth=1.2
    ];

    edge [
        color="#475569",
        arrowsize=0.7,
        penwidth=1.3
    ];

    input [label="Input token IDs\n[B, T]  •  T ≤ 256", fillcolor="#DBEAFE", color="#3B82F6"];
    embedding [label="Token Embedding\n8,192 × 256", fillcolor="#DCFCE7", color="#22C55E"];
    cnn1 [label="Local Mixer 1 • dilation 1\nPre-RMSNorm → causal Conv1d → GLU → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
    ffn1 [label="SwiGLU 1\nPre-RMSNorm → 256→640 gate/up → SiLU → 640→256 → Residual", fillcolor="#ECFCCB", color="#84CC16"];
    attention1 [label="Global Mixer 1\nPre-RMSNorm → 8-head causal attention + RoPE → Residual", fillcolor="#EDE9FE", color="#8B5CF6"];
    ffn2 [label="SwiGLU 2\nPre-RMSNorm → 256→640 gate/up → SiLU → 640→256 → Residual", fillcolor="#ECFCCB", color="#84CC16"];
    cnn2 [label="Local Mixer 2 • dilation 2\nPre-RMSNorm → causal Conv1d → GLU → Residual", fillcolor="#FEF3C7", color="#F59E0B"];
    ffn3 [label="SwiGLU 3\nPre-RMSNorm → 256→640 gate/up → SiLU → 640→256 → Residual", fillcolor="#ECFCCB", color="#84CC16"];
    attention2 [label="Global Mixer 2\nPre-RMSNorm → 8-head causal attention + RoPE → Residual", fillcolor="#EDE9FE", color="#8B5CF6"];
    ffn4 [label="SwiGLU 4\nPre-RMSNorm → 256→640 gate/up → SiLU → 640→256 → Residual", fillcolor="#ECFCCB", color="#84CC16"];
    final_norm [label="Final RMSNorm\n256 channels", fillcolor="#E2E8F0", color="#64748B"];
    lm_head [label="Tied Language-Model Head\nLinear 256 → 8,192 + bias", fillcolor="#F3E8FF", color="#A855F7"];
    logits [label="Next-token logits\n[B, T, 8,192]", fillcolor="#FFE4E6", color="#F43F5E"];
    summary [
        shape=note,
        style="filled",
        label="Default configuration\n5,387,520 parameters\n2 gated CNNs + 2 RoPE attention mixers\n4 bias-free SwiGLU channel mixers",
        fillcolor="#F1F5F9",
        color="#94A3B8",
        fontsize=10
    ];

    input -> embedding -> cnn1 -> ffn1 -> attention1 -> ffn2;
    ffn2 -> cnn2 -> ffn3 -> attention2 -> ffn4;
    ffn4 -> final_norm -> lm_head -> logits;
    embedding -> lm_head [
        xlabel="shared weights",
        style=dashed,
        color="#9333EA",
        fontcolor="#7E22CE",
        constraint=false
    ];
    { rank=same; final_norm; summary; }
    summary -> final_norm [style=invis];
}
